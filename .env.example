# ==============================================================================
# MarcaAí — Variáveis de Ambiente (.env.example)
# ------------------------------------------------------------------------------
# Copie este arquivo para `.env` (ou `.env.local`) e preencha os valores reais.
# NÃO comite o arquivo `.env` (já está no .gitignore via `.env*`).
#
# Legenda:
#   [OBRIGATÓRIA]  -> app não sobe / valida sem ela (ver lib/env.ts)
#   [CONDICIONAL]  -> obrigatória só se o recurso correspondente estiver ativo
#   [OPCIONAL]     -> tem fallback / recurso degrada graciosamente sem ela
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS  [OBRIGATÓRIA]
# ------------------------------------------------------------------------------
# String de conexão PostgreSQL. Usada pelo Prisma (adapter @prisma/adapter-pg).
# Dev local (docker-compose.yml deste repo): user/password/testdb na porta 5432.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/testdb?schema=public"


# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO — NextAuth v5 (Auth.js)  [OBRIGATÓRIAS]
# ------------------------------------------------------------------------------
# Segredo para assinar/criptografar os JWTs da sessão.
# Gere um novo com:  openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-bytes"

# URL canônica da aplicação para o NextAuth (callbacks OAuth).
# Em dev geralmente pode ficar em branco; em produção use a URL pública.
# (Opcional em dev — o Auth.js infere a partir dos headers.)
AUTH_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH + GOOGLE CALENDAR  [OBRIGATÓRIAS p/ login e sync]
# ------------------------------------------------------------------------------
# Credenciais do OAuth Client (tipo "Web application") no Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Redirect URI autorizado (dev): http://localhost:3000/api/auth/callback/google
# Scopes já solicitados pelo app (auth.config.ts):
#   openid email profile
#   https://www.googleapis.com/auth/calendar.readonly
#   https://www.googleapis.com/auth/calendar.events
# Requer a "Google Calendar API" HABILITADA no projeto do Cloud Console.
AUTH_GOOGLE_ID="COLE_AQUI.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="COLE_AQUI_google_client_secret"


# ------------------------------------------------------------------------------
# 4. URL PÚBLICA DA APLICAÇÃO  [OBRIGATÓRIA na prática]
# ------------------------------------------------------------------------------
# Usada em links de e-mail/WhatsApp, success/cancel do Stripe e notification_url
# do Mercado Pago. Tem fallback para http://localhost:3000, mas defina sempre.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 5. STRIPE — Assinaturas B2B (SaaS)  [CONDICIONAL]
# ------------------------------------------------------------------------------
# Necessário para o fluxo de billing das equipes (lib/actions/billing.ts).
# ATENÇÃO: em lib/env.ts, se STRIPE_SECRET_KEY estiver definida,
#          STRIPE_WEBHOOK_SECRET passa a ser OBRIGATÓRIA (superRefine).
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="COLE_AQUI_stripe_secret_key"
# Segredo de assinatura do endpoint de webhook (whsec_...).
# Obtido ao criar o webhook no painel, ou via `stripe listen` (Stripe CLI) em dev.
STRIPE_WEBHOOK_SECRET="COLE_AQUI_stripe_webhook_secret"
# ID do preço (recurring) do plano Pro. Painel > Products > Price.
STRIPE_PRO_PRICE_ID="COLE_AQUI_stripe_price_id"


# ------------------------------------------------------------------------------
# 6. MERCADO PAGO — Pagamento PIX de agendamentos  [CONDICIONAL]
# ------------------------------------------------------------------------------
# Necessário quando um EventType tem preço > 0 (gera cobrança PIX no booking).
# Access token: https://www.mercadopago.com.br/developers/panel/app -> Credenciais
MERCADOPAGO_ACCESS_TOKEN="COLE_AQUI_mercadopago_access_token"
# Declarada em lib/env.ts, porém o handler de webhook atual NÃO valida assinatura.
# Reserve a chave agora para quando a verificação de assinatura for implementada.
MERCADOPAGO_WEBHOOK_SECRET=""


# ------------------------------------------------------------------------------
# 7. RESEND — E-mails transacionais + magic link  [CONDICIONAL/OPCIONAL]
# ------------------------------------------------------------------------------
# Usado pelo provider Resend do NextAuth (login por e-mail) e pelos e-mails de
# confirmação/cancelamento. Sem a chave, o Resend usa "mock-api-key" e não envia.
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY="COLE_AQUI_resend_api_key"
# Remetente. Precisa ser de um domínio verificado no Resend em produção.
# Fallback: "Marca AI <onboarding@resend.dev>".
# OBS: auth.ts tem um "from" HARDCODED (no-reply@marca-ai-app.vercel.app) —
#      recomendo trocar por esta variável ao recuperar o ambiente.
RESEND_FROM_EMAIL="Marca AI <no-reply@seudominio.com>"


# ------------------------------------------------------------------------------
# 8. WHATSAPP — Evolution API (notificações/lembretes)  [OPCIONAL]
# ------------------------------------------------------------------------------
# Sem estas duas, o envio cai em modo SIMULADO (só loga no console).
# URL base da sua instância Evolution API.
WHATSAPP_API_URL="https://sua-evolution-api.com"
WHATSAPP_API_KEY="sua-apikey-da-evolution"
# OBS: o nome da instância está HARDCODED como "InstanceName" em
#      lib/whatsapp/send.ts. Considere extrair para WHATSAPP_INSTANCE_NAME.
# WHATSAPP_INSTANCE_NAME="InstanceName"


# ------------------------------------------------------------------------------
# 9. CRON — Lembretes agendados  [OPCIONAL, recomendado em produção]
# ------------------------------------------------------------------------------
# Protege GET /api/cron/reminders. Se definida, o chamador precisa enviar
# o header: Authorization: Bearer <CRON_SECRET>. Vercel Cron injeta isso.
CRON_SECRET="troque-por-um-token-aleatorio"
